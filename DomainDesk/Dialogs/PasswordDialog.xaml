<Window x:Class="DomainDesk.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置用户密码" Style="{StaticResource {x:Type Window}}" Width="480" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="30,24">
        <TextBlock Text="重置密码" FontSize="25" FontWeight="SemiBold" />
        <TextBlock x:Name="TargetText" TextWrapping="Wrap" Margin="0,12,0,4" Foreground="{StaticResource Muted}" />
        <TextBlock Text="新密码" Style="{StaticResource Caption}" />
        <PasswordBox x:Name="NewPasswordBox" />
        <TextBlock Text="再次输入新密码" Style="{StaticResource Caption}" />
        <PasswordBox x:Name="ConfirmPasswordBox" />
        <CheckBox x:Name="MustChangeBox" IsChecked="True" Content="用户下次登录时必须更改密码" Margin="0,17,0,8" />
        <TextBlock Text="密码需满足目标域的复杂度、长度及历史策略。密码不会写入日志或配置文件。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
        <TextBlock x:Name="ValidationText" Foreground="#BA4A37" TextWrapping="Wrap" Margin="0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" />
            <Button Content="确认重置" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Submit_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
