<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DomainDesk.ico</ApplicationIcon>
    <AssemblyName>DomainDesk</AssemblyName>
    <Version>1.5.2</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\DomainDesk.ico" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.2" />
  </ItemGroup>
</Project>
