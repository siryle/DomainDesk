<Window x:Class="DomainDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainDesk"
        Title="域控台 · Domain Desk 1.5.2" Icon="Assets/DomainDesk.ico" Style="{StaticResource {x:Type Window}}" Width="1390" Height="880" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Grid x:Name="WorkspaceRoot" Background="#F4F7F5" SizeChanged="Window_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0B5B58" Padding="30,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="34" Height="34" Margin="0,0,12,0" />
                    <TextBlock Text="域控台" FontSize="27" Foreground="#F2FAF6" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="ConnectButton" Content="连接 AD 域" Click="Connect_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#A7E8D4" Foreground="#0B4D48" BorderBrush="#A7E8D4" Padding="19,10" Margin="0" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="26,20,26,16">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="DirectoryPanel">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanVisibility}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="Stem" Grid.RowSpan="2" Width="1" Background="#DCE3DE" HorizontalAlignment="Left" Margin="9,0,0,0" />
                            <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Branch" Width="11" Height="1" Background="#DCE3DE" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Border x:Name="Selection" Grid.Column="1" Background="Transparent" CornerRadius="2" />
                            <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="26" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#EEF3E4" Margin="2,6"><Path x:Name="Arrow" Data="M 1 1 L 5 5 L 1 9" Stroke="#436A53" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 1 2 L 5 6 L 9 2" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="HeaderContent" Grid.Column="1" ContentSource="Header" Margin="2,0,5,0" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsPresenter x:Name="Children" Grid.Row="1" Margin="20,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed" /></Trigger>
                            <DataTrigger Binding="{Binding IsLastVisibleSibling}" Value="True"><Setter TargetName="Stem" Property="Height" Value="13" /><Setter TargetName="Stem" Property="VerticalAlignment" Value="Top" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsDomainRoot}" Value="True"><Setter TargetName="Stem" Property="Visibility" Value="Collapsed" /><Setter TargetName="Branch" Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#0C8A78" /><Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="#F7FFFB" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                    <HierarchicalDataTemplate DataType="{x:Type local:DirectoryNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                            <Grid Width="17" Height="17" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Grid x:Name="FolderIcon">
                                    <Path Data="M 1 4 L 1 2 L 7 2 L 9 4 L 15 4 L 15 14 L 1 14 Z" Fill="#F3D477" Stroke="#B89540" StrokeThickness="0.8" />
                                    <Path Data="M 1 6 L 16 6 L 14 14 L 1 14 Z" Fill="#FFE7A1" Stroke="#B89540" StrokeThickness="0.8" />
                                    <Grid x:Name="OuBadge" Visibility="Collapsed" Margin="4,7,5,3"><Rectangle Fill="#FFFBEA" Stroke="#A78D43" StrokeThickness="0.7" /><Path Data="M 2 2 L 5 2 M 2 4 L 5 4" Stroke="#A78D43" StrokeThickness="0.7" /></Grid>
                                </Grid>
                                <Grid x:Name="DomainIcon" Visibility="Collapsed">
                                    <Path Data="M 8 7 L 8 10 M 3 13 L 3 10 L 13 10 L 13 13" Stroke="#65816F" StrokeThickness="1" />
                                    <Rectangle Width="8" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#D3E6EF" Stroke="#5D8996" />
                                    <Path Data="M 5 2 L 11 2 M 5 4 L 11 4" Stroke="#689AAB" StrokeThickness="0.8" />
                                    <Rectangle Width="5" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#F2D87E" Stroke="#AF9449" />
                                    <Rectangle Width="5" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#F2D87E" Stroke="#AF9449" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOu}" Value="True"><Setter TargetName="OuBadge" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsDomainRoot}" Value="True"><Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="DomainIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter TargetName="FolderIcon" Property="Opacity" Value="0.4" /></DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="OuColumn" Width="260" /><ColumnDefinition x:Name="OuGap" Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition x:Name="InspectorColumn" Width="270" /></Grid.ColumnDefinitions>
                    <Border x:Name="OuPanel" Background="#EEF3E4" BorderBrush="#D5DECC" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="17,19,17,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><TextBlock Text="目录树" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="刷新目录" Click="RefreshTree_Click" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Padding="9,7" Margin="0" /></Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,10">
                                <TextBox x:Name="OuFilterBox" ToolTip="仅筛选目录名称，不改变对象查询范围" TextChanged="OuFilter_Changed" FontSize="12" />
                                <TextBlock Text="筛选 OU / 容器名称…" FontSize="12" Foreground="#8B9B96" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=OuFilterBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TreeView Grid.Row="2" x:Name="OuTree" SelectedItemChanged="OuTree_SelectedItemChanged" Foreground="#183F3A" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="13" />
                            <TextBlock Grid.Row="3" x:Name="TreeNotice" Foreground="#796027" FontSize="11" LineHeight="18" TextWrapping="Wrap" Text="请先连接 AD 域。" Margin="0,10,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="UserScopeHeader" Margin="20,19,20,0">
                                <TextBlock x:Name="ScopeBreadcrumb" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock x:Name="ScopeTitle" Text="选择目录" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,6" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,13,0,0"><CheckBox x:Name="IncludeDescendantsBox" Content="包含下级目录" IsChecked="True" Checked="ScopeDepth_Changed" Unchecked="ScopeDepth_Changed" Margin="0,0,15,8" /><TextBlock x:Name="UserCounts" FontSize="12" Foreground="#516F65" VerticalAlignment="Center" Margin="0,0,0,8" /></WrapPanel>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="18,12,18,14" x:Name="DirectoryToolbar">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="在当前目录及对象类型范围内查询，Enter 搜索" KeyDown="Search_KeyDown" /><Button Grid.Column="1" Content="查询" Click="Search_Click" Margin="8,0,0,0" /></Grid>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,-8">
                                <ComboBox x:Name="ObjectTypeBox" SelectedIndex="0" SelectionChanged="ObjectType_Changed" Width="105" Height="39" Padding="7" Margin="0,0,8,8" VerticalContentAlignment="Center" ToolTip="只筛选当前目录范围内的对象类型，不切换目录">
                                    <ComboBoxItem Content="全部类型" Tag="All" /><ComboBoxItem Content="用户" Tag="Users" /><ComboBoxItem Content="用户组" Tag="Groups" /><ComboBoxItem Content="计算机" Tag="Computers" />
                                </ComboBox>
                                <Button x:Name="NewUserButton" Content="+ 新建用户" Click="NewUser_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button x:Name="NewComputerButton" Content="+ 新建计算机" Click="NewComputer_Click" ToolTip="预创建停用的 AD 计算机账号，不执行远端加域" Margin="0,0,8,8" />
                                <Button x:Name="NewGroupButton" Content="+ 新建组" Click="NewGroup_Click" ToolTip="创建空安全组或通讯组，可选择组作用域" Margin="0,0,8,8" />
                                <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,8" /><Button x:Name="ExportButton" Content="导出 CSV" Click="Export_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="ObjectsGrid" SelectionChanged="Objects_SelectionChanged" RowHeight="52" FrozenColumnCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="1.1*" MinWidth="110" />
                                        <DataGridTextColumn x:Name="TypeColumn" Header="类型" Binding="{Binding KindLabel}" Width="70" MinWidth="70" />
                                        <DataGridTextColumn x:Name="AccountColumn" Header="账号 / 计算机名" Binding="{Binding DisplayAccount}" Width="*" MinWidth="100" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="88" MinWidth="88" />
                                        <DataGridTextColumn x:Name="ContainerColumn" Header="所在 OU / 容器" Binding="{Binding ContainerName}" Width="1.1*" MinWidth="115" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="EmptyText" Text="当前范围暂无匹配对象。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="15" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                            <Border Grid.Row="3" x:Name="UserScopeHint" Background="#F7FAF8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12"><TextBlock Text="搜索、统计与导出遵循当前目录范围；新建默认使用选中 OU。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" /></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="19,19">
                        <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="对象详情" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock x:Name="DetailType" Foreground="#087F71" FontSize="11" Margin="0,7,0,0" />
                                <TextBlock x:Name="DetailName" Text="选择一个对象" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,6" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailAccount" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <StackPanel x:Name="AccountActions" Margin="0,14,0,0">
                                    <TextBlock Text="账号操作" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2">
                                        <Button x:Name="UnlockButton" Content="解锁" Tag="Unlock" Click="AccountAction_Click" Margin="0,0,7,8" />
                                        <Button x:Name="PasswordButton" Content="重置密码" Tag="ResetPassword" Click="AccountAction_Click" Margin="0,0,0,8" />
                                        <Button x:Name="EnableButton" Content="启用" Tag="Enable" Click="AccountAction_Click" Margin="0,0,7,0" />
                                        <Button x:Name="DisableButton" Content="停用" Tag="Disable" Click="AccountAction_Click" Foreground="#B74B36" Margin="0" />
                                    </UniformGrid>
                                    <TextBlock x:Name="WriteHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,11,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="GroupActions" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Button x:Name="MembersButton" Content="查看 / 管理组用户成员" Click="Members_Click" Margin="0" />
                                    <TextBlock Text="只读连接也能查看；添加/移除需要写权限，并逐次确认。" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="ComputerActions" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Button x:Name="EditComputerButton" Content="编辑描述 / 位置" Click="ComputerEdit_Click" Margin="0,0,0,8" />
                                    <Button x:Name="DeleteComputerButton" Content="删除 AD 计算机对象" Click="ComputerDelete_Click" Foreground="#B74B36" Margin="0" />
                                    <TextBlock Text="不更改远端机器名称；不移除账号末尾真实的 $。域控与关键系统对象禁止修改。" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock Text="状态" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailStatus" />
                                <StackPanel><TextBlock Text="所在 OU / 容器" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailContainer" TextWrapping="Wrap" /><StackPanel x:Name="UserDepartmentPanel"><TextBlock Text="部门" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailDepartment" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                <TextBlock Text="邮箱 / 说明" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailEmail" TextWrapping="Wrap" />
                                <StackPanel x:Name="LogonPanel"><TextBlock Text="最近登录时间戳（非实时，可能延迟）" Style="{StaticResource Caption}" FontSize="10" /><TextBlock x:Name="DetailLogon" /></StackPanel>
                                <TextBlock Text="直接所属组" Style="{StaticResource Caption}" /><TextBlock Text="不含主组 / 嵌套组；可能截断" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock x:Name="DetailGroups" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10" Foreground="#087F71" />
                <TextBlock Grid.Row="1" x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Grid>
</Window>

