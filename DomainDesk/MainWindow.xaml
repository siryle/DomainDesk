<Window x:Class="DomainDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainDesk"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="域控台 · Domain Desk 1.6.2" Icon="Assets/DomainDesk.ico" Style="{StaticResource {x:Type Window}}" shell:WindowChrome.WindowChrome="{StaticResource WindowChrome}" WindowStyle="None" Width="1390" Height="880" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Border x:Name="WindowFrame" BorderBrush="#8BA7A2" BorderThickness="1" Background="{StaticResource Canvas}" SnapsToDevicePixels="True">
    <Grid x:Name="WorkspaceRoot" Background="{StaticResource Canvas}" SizeChanged="Window_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource TitleBar}">
            <Grid>
                <TextBlock Text="域控台 · Domain Desk" Foreground="#E8F4F1" FontSize="12" Margin="22,0,150,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="46" /><Setter Property="Height" Value="38" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E8F4F1" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16,12" /><Setter Property="Margin" Value="0" /></Style>
                    </StackPanel.Resources>
                    <Button x:Name="MinimizeButton" Click="Minimize_Click" AutomationProperties.Name="最小化" ToolTip="最小化"><Path Data="M 0 5 L 12 5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="12" Height="12" /></Button>
                    <Button x:Name="MaximizeButton" Click="Maximize_Click" AutomationProperties.Name="最大化或还原" ToolTip="最大化 / 还原"><Path Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="11" Height="11" /></Button>
                    <Button x:Name="CloseButton" Click="Close_Click" AutomationProperties.Name="关闭" ToolTip="关闭"><Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="11" Height="11" /></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="32" Height="34" Margin="0,0,12,0" AutomationProperties.Name="域控台标志">
                        <Canvas Width="36" Height="40">
                            <Path Data="M 7 3 L 24 3 L 32 11 L 32 28 L 21 37 L 7 37 Z M 7 20 L 19 20 L 27 12 M 19 20 L 27 29" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeLineJoin="Round" />
                            <Rectangle Canvas.Left="4" Canvas.Top="17" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1.5" />
                            <Rectangle Canvas.Left="16" Canvas.Top="17" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1.5" />
                            <Rectangle Canvas.Left="24" Canvas.Top="9" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1.5" />
                            <Rectangle Canvas.Left="24" Canvas.Top="26" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="域控台" FontSize="25" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
                    <TextBlock Text="Domain Desk" FontSize="13" Foreground="{StaticResource Muted}" Margin="12,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#819298" Margin="0,0,9,0" />
                    <TextBlock x:Name="ConnectionLabel" Text="尚未连接" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ConnectButton" Content="连接 AD 域" Click="Connect_Click" Style="{StaticResource HeaderButton}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="24,16,24,14">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="DirectoryPanel">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
                    <DataTemplate x:Key="ObjectNameCell">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DisplayName}">
                            <Path x:Name="ObjectIcon" Data="M 6 1 A 3 3 0 1 1 6 7 A 3 3 0 1 1 6 1 M 1 15 L 1 12 C 1 8 11 8 11 12 L 11 15 Z" Stroke="{StaticResource AccentDark}" StrokeThickness="1.2" Width="16" Height="17" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Computers"><Setter TargetName="ObjectIcon" Property="Data" Value="M 1 1 L 15 1 L 15 11 L 1 11 Z M 5 15 L 11 15 M 8 11 L 8 15" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Groups"><Setter TargetName="ObjectIcon" Property="Data" Value="M 5 1 A 3 3 0 1 1 5 7 A 3 3 0 1 1 5 1 M 1 15 L 1 12 C 1 8 10 8 10 12 L 10 15 Z M 11 2 C 16 2 16 8 12 8 M 13 10 C 16 10 17 12 17 15 L 13 15" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                    <DataTemplate x:Key="ObjectStatusCell">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#788D95" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="已启用"><Setter TargetName="StatusDot" Property="Fill" Value="#259C60" /></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="已锁定"><Setter TargetName="StatusDot" Property="Fill" Value="#B46B0C" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Groups"><Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanVisibility}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="Stem" Grid.RowSpan="2" Width="1" Background="#D3E2DD" HorizontalAlignment="Left" Margin="9,0,0,0" />
                            <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Branch" Width="11" Height="1" Background="#D3E2DD" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Border x:Name="Selection" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="4" Margin="0,1,0,1" />
                            <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="26" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#E7F0ED" CornerRadius="3" Margin="2,6"><Path x:Name="Arrow" Data="M 1 1 L 5 5 L 1 9" Stroke="#52746D" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 1 2 L 5 6 L 9 2" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="HeaderContent" Grid.Column="1" ContentSource="Header" Margin="2,0,5,0" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsPresenter x:Name="Children" Grid.Row="1" Margin="20,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed" /></Trigger>
                            <DataTrigger Binding="{Binding IsLastVisibleSibling}" Value="True"><Setter TargetName="Stem" Property="Height" Value="13" /><Setter TargetName="Stem" Property="VerticalAlignment" Value="Top" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsDomainRoot}" Value="True"><Setter TargetName="Stem" Property="Visibility" Value="Collapsed" /><Setter TargetName="Branch" Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{StaticResource Selection}" /><Setter TargetName="Selection" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Selection" Property="BorderThickness" Value="3,0,0,0" /><Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="{StaticResource AccentDark}" /><Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                    <HierarchicalDataTemplate DataType="{x:Type local:DirectoryNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                            <Grid Width="17" Height="17" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Grid x:Name="FolderIcon">
                                    <Path Data="M 1 4 L 1 2 L 7 2 L 9 4 L 15 4 L 15 14 L 1 14 Z" Fill="#DCEDE7" Stroke="#5E8A82" StrokeThickness="0.8" />
                                    <Path Data="M 1 6 L 16 6 L 14 14 L 1 14 Z" Fill="#F4FBF8" Stroke="#5E8A82" StrokeThickness="0.8" />
                                    <Grid x:Name="OuBadge" Visibility="Collapsed" Margin="4,7,5,3"><Rectangle Fill="#F4FBF8" Stroke="#5E8A82" StrokeThickness="0.7" /><Path Data="M 2 2 L 5 2 M 2 4 L 5 4" Stroke="#5E8A82" StrokeThickness="0.7" /></Grid>
                                </Grid>
                                <Grid x:Name="DomainIcon" Visibility="Collapsed">
                                    <Path Data="M 8 7 L 8 10 M 3 13 L 3 10 L 13 10 L 13 13" Stroke="#52746D" StrokeThickness="1" />
                                    <Rectangle Width="8" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#E5F1EE" Stroke="#5E8A82" />
                                    <Path Data="M 5 2 L 11 2 M 5 4 L 11 4" Stroke="#5E8A82" StrokeThickness="0.8" />
                                    <Rectangle Width="5" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#DCEDE7" Stroke="#5E8A82" />
                                    <Rectangle Width="5" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#DCEDE7" Stroke="#5E8A82" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOu}" Value="True"><Setter TargetName="OuBadge" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsDomainRoot}" Value="True"><Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="DomainIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter TargetName="FolderIcon" Property="Opacity" Value="0.4" /></DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="OuColumn" Width="260" /><ColumnDefinition x:Name="OuGap" Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition x:Name="InspectorColumn" Width="270" /></Grid.ColumnDefinitions>
                    <Border x:Name="OuPanel" Background="{StaticResource TreeSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <Grid Margin="16,16,16,14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><TextBlock Text="目录树" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Click="RefreshTree_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" MinHeight="32" Padding="7" Margin="0" ToolTip="刷新目录" AutomationProperties.Name="刷新目录"><Path Data="M 13 5 A 6 6 0 1 0 14 11 M 13 1 L 13 5 L 9 5" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" /></Button></Grid>
                            <Grid Grid.Row="1" Margin="0,12,0,10">
                                <TextBox x:Name="OuFilterBox" ToolTip="仅筛选目录名称，不改变对象查询范围" AutomationProperties.Name="筛选目录名称" TextChanged="OuFilter_Changed" FontSize="12" Padding="30,9,10,9" />
                                <Path Data="M 11 6 A 5 5 0 1 1 1 6 A 5 5 0 1 1 11 6 M 10 10 L 15 15" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="15" Height="15" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="筛选 OU / 容器名称" FontSize="12" Foreground="{StaticResource Muted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=OuFilterBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TreeView Grid.Row="2" x:Name="OuTree" SelectedItemChanged="OuTree_SelectedItemChanged" Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="13" />
                            <TextBlock Grid.Row="3" x:Name="TreeNotice" Foreground="#796027" FontSize="11" LineHeight="18" TextWrapping="Wrap" Text="请先连接 AD 域。" Margin="0,10,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="UserScopeHeader" Margin="20,18,20,0">
                                <TextBlock x:Name="ScopeBreadcrumb" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="ScopeTitle" Text="选择目录" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,6" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="IncludeDescendantsBox" Content="包含下级目录" IsChecked="True" Checked="ScopeDepth_Changed" Unchecked="ScopeDepth_Changed" Margin="0,0,15,8" /><TextBlock x:Name="UserCounts" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8" /></WrapPanel>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="18,12,18,14" x:Name="DirectoryToolbar">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="SearchBox" ToolTip="在当前目录及对象类型范围内查询，Enter 搜索" AutomationProperties.Name="搜索名称、账号或计算机名" KeyDown="Search_KeyDown" Padding="32,9,10,9" />
                                        <Path Data="M 11 6 A 5 5 0 1 1 1 6 A 5 5 0 1 1 11 6 M 10 10 L 15 15" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="15" Height="15" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBlock Text="搜索名称、账号或计算机名" Foreground="{StaticResource Muted}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Content="查询" Click="Search_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                </Grid>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,-8">
                                <ComboBox x:Name="ObjectTypeBox" Style="{StaticResource TypeSelector}" SelectedIndex="0" SelectionChanged="ObjectType_Changed" Width="105" Height="39" Padding="7" Margin="0,0,8,8" VerticalContentAlignment="Center" ToolTip="只筛选当前目录范围内的对象类型，不切换目录">
                                    <ComboBoxItem Content="全部类型" Tag="All" /><ComboBoxItem Content="用户" Tag="Users" /><ComboBoxItem Content="用户组" Tag="Groups" /><ComboBoxItem Content="计算机" Tag="Computers" />
                                </ComboBox>
                                <Button x:Name="NewUserButton" Content="+ 新建用户" Click="NewUser_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button x:Name="NewComputerButton" Content="+ 新建计算机" Click="NewComputer_Click" ToolTip="预创建停用的 AD 计算机账号，不执行远端加域" Margin="0,0,8,8" />
                                <Button x:Name="NewGroupButton" Content="+ 新建组" Click="NewGroup_Click" ToolTip="创建空安全组或通讯组，可选择组作用域" Margin="0,0,8,8" />
                                <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,8" /><Button x:Name="ExportButton" Content="导出 CSV" Click="Export_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="ObjectsGrid" SelectionChanged="Objects_SelectionChanged" RowHeight="52" FrozenColumnCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="名称" SortMemberPath="DisplayName" ClipboardContentBinding="{Binding DisplayName}" CellTemplate="{StaticResource ObjectNameCell}" Width="1.3*" MinWidth="205" />
                                        <DataGridTextColumn x:Name="TypeColumn" Header="类型" Binding="{Binding KindLabel}" Width="70" MinWidth="70" />
                                        <DataGridTextColumn x:Name="AccountColumn" Header="账号 / 计算机名" Binding="{Binding DisplayAccount}" Width="*" MinWidth="145" />
                                        <DataGridTemplateColumn Header="状态" SortMemberPath="Status" ClipboardContentBinding="{Binding Status}" CellTemplate="{StaticResource ObjectStatusCell}" Width="94" MinWidth="94" />
                                        <DataGridTextColumn x:Name="ContainerColumn" Header="所在 OU / 容器" Binding="{Binding ContainerName}" Width="1.1*" MinWidth="115" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="EmptyText" Text="当前范围暂无匹配对象。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="15" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                            <Border Grid.Row="3" x:Name="UserScopeHint" Background="#FAFCFB" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12"><TextBlock Text="搜索、统计与导出遵循当前目录范围；新建默认使用选中 OU。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" /></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18,18">
                        <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="对象详情" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="DetailType" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,10,0,0" />
                                <TextBlock x:Name="DetailName" Text="选择一个对象" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,5" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailAccount" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <Border Height="1" Background="{StaticResource SoftLine}" Margin="0,12,0,0" />
                                <StackPanel x:Name="AccountActions" Margin="0,10,0,0">
                                    <TextBlock Text="账号操作" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2">
                                        <Button x:Name="UnlockButton" Content="解锁" Tag="Unlock" Click="AccountAction_Click" Margin="0,0,7,8" />
                                        <Button x:Name="PasswordButton" Content="重置密码" Tag="ResetPassword" Click="AccountAction_Click" Margin="0,0,0,8" />
                                        <Button x:Name="EnableButton" Content="启用" Tag="Enable" Click="AccountAction_Click" Margin="0,0,7,0" />
                                        <Button x:Name="DisableButton" Content="停用" Tag="Disable" Click="AccountAction_Click" Foreground="#BD3737" BorderBrush="#F0CACA" Margin="0" />
                                    </UniformGrid>
                                    <TextBlock x:Name="WriteHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,11,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="GroupActions" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Button x:Name="MembersButton" Content="查看 / 管理组用户成员" Click="Members_Click" Margin="0" />
                                    <TextBlock Text="只读连接也能查看；添加/移除需要写权限，并逐次确认。" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="ComputerActions" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Button x:Name="EditComputerButton" Content="编辑描述 / 位置" Click="ComputerEdit_Click" Margin="0,0,0,8" />
                                    <Button x:Name="DeleteComputerButton" Content="删除 AD 计算机对象" Click="ComputerDelete_Click" Foreground="#B74B36" Margin="0" />
                                    <TextBlock Text="不更改远端机器名称；不移除账号末尾真实的 $。域控与关键系统对象禁止修改。" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock Text="状态" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailStatus" />
                                <StackPanel><TextBlock Text="所在 OU / 容器" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailContainer" TextWrapping="Wrap" /><StackPanel x:Name="UserDepartmentPanel"><TextBlock Text="部门" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailDepartment" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                <TextBlock Text="邮箱 / 说明" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailEmail" TextWrapping="Wrap" />
                                <StackPanel x:Name="LogonPanel"><TextBlock Text="最近登录时间" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailLogon" /><TextBlock Text="非实时，可能延迟" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                                <TextBlock Text="直接所属组" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailGroups" TextWrapping="Wrap" FontSize="12" LineHeight="18" /><TextBlock Text="不含主组 / 嵌套组；可能截断" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="1" Margin="-24,12,-24,-14" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
